{
  "realm": "dockmind",
  "enabled": true,
  "displayName": "DockMind",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Manage docks, approve large recovery plans"
      },
      {
        "name": "DISPATCHER",
        "description": "Book shipments, compute schedules, handle disruptions"
      },
      {
        "name": "VIEWER",
        "description": "Read-only access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dockmind-web",
      "name": "DockMind web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dockmind-smoke",
      "name": "Local smoke tests only (password grant)",
      "enabled": true,
      "publicClient": false,
      "secret": "${DOCKMIND_SMOKE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin.acme",
      "email": "admin.acme@example.test",
      "firstName": "Ada",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "acme"
        ]
      },
      "realmRoles": [
        "ADMIN",
        "default-roles-dockmind"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "dispatcher.acme",
      "email": "dispatcher.acme@example.test",
      "firstName": "Dan",
      "lastName": "Dispatcher",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "acme"
        ]
      },
      "realmRoles": [
        "DISPATCHER",
        "default-roles-dockmind"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "viewer.acme",
      "email": "viewer.acme@example.test",
      "firstName": "Vera",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "acme"
        ]
      },
      "realmRoles": [
        "VIEWER",
        "default-roles-dockmind"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "dispatcher.globex",
      "email": "dispatcher.globex@example.test",
      "firstName": "Gil",
      "lastName": "Globex",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "tenant_id": [
          "globex"
        ]
      },
      "realmRoles": [
        "DISPATCHER",
        "default-roles-dockmind"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant\", \"validations\": {\"pattern\": {\"pattern\": \"^[a-z0-9][a-z0-9-]{0,63}$\", \"error-message\": \"Lowercase letters, digits and dashes\"}}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
