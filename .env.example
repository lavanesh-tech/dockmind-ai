# Copy to .env and fill in. .env is gitignored and must never be committed.
DB_USERNAME=dockmind
DB_PASSWORD=change-me-to-a-long-random-value

# Only needed to try the AI assistant live. Put the real key in .env (never committed), not here.
OPENAI_API_KEY=

# Login (Keycloak). scripts/run-local.sh fills these with random values if they are missing.
KC_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
DOCKMIND_SMOKE_CLIENT_SECRET=
